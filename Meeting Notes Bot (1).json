      "id": "19e4a56d-1e60-4c60-851c-9b51438014c4",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const text = $json.candidates[0].content.parts[0].text;\n\nconst summary = text.match(/Summary:\\s*(.+?)(?=Decisions:|$)/s)?.[1]?.trim() || '';\nconst decisions = text.match(/Decisions:\\s*(.+?)(?=Action Items:|$)/s)?.[1]?.trim() || '';\nconst actionItems = text.match(/Action Items:\\s*(.+)/s)?.[1]?.trim() || '';\n\nreturn {\n  json: {\n    chatId: $('Telegram Trigger').item.json.message.chat.id,\n    summary,\n    decisions,\n    actionItems\n  }\n};"
      },
