        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [\n      { \"text\": \"This is a meeting recording. Listen and provide: 1) A brief summary (2-3 sentences), 2) Key decisions made, 3) Action items (who does what). Format exactly as:\\nSummary: <text>\\nDecisions: <text>\\nAction Items: <text>\" },\n      { \"inline_data\": { \"mime_type\": \"audio/mpeg\", \"data\": \"{{ $json.audioBase64 }}\" } }\n    ]\n  }]\n}",
        "options": {}
      },
